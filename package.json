{
  "name": "bullex-start",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run tests/integration/rls.test.ts",
    "test:http": "cross-env RUN_HTTP=1 vitest run tests/integration/http.test.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "seed:videos": "tsx scripts/seed-videos.ts",
    "seed:module01": "tsx scripts/upload-module-01-videos.ts",
    "seed:quiz": "tsx scripts/seed-quiz.ts",
    "broker:event": "tsx scripts/send-broker-event.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
