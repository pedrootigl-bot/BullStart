# ---------------------------------------------------------------------------
# Bull Academy — variáveis de ambiente
# Todas são lidas apenas no servidor. Nenhuma é exposta ao navegador.
# ---------------------------------------------------------------------------

# URL pública da aplicação (usada em redirecionamentos de e-mail, QR code do certificado e checagem de origem)
APP_URL=http://localhost:3000

# Supabase
# SUPABASE_URL: endereço usado pelo servidor Next.js para falar com o Supabase
#   (em Docker: http://host.docker.internal:54321 ou URL do projeto em produção)
# SUPABASE_PUBLIC_URL: endereço alcançável pelo navegador (URLs assinadas de vídeo e CSP)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Chave privilegiada: somente servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Slug do curso principal exibido na landing e na plataforma
PRIMARY_COURSE_SLUG=formacao-trader-bullex

# Integração com a corretora
#   disabled  -> sem integração ativa: elegibilidade só via webhook assinado
#   mock      -> SOMENTE desenvolvimento; ignorado quando NODE_ENV=production
#   official  -> adapter oficial (pendente de documentação/credenciais da Bullex)
BROKER_INTEGRATION_MODE=disabled
# Segredo HMAC-SHA256 compartilhado para validar webhooks (mínimo 32 caracteres)
BROKER_WEBHOOK_SECRET=
# (mock) chaves de requisito que o adapter mock considera elegíveis, separadas por vírgula
BROKER_MOCK_ELIGIBLE_KEYS=
# URL OFICIAL da área de depósito fornecida pela Bullex (https). Vazio => botão não é exibido.
BROKER_OFFICIAL_DEPOSIT_URL=
# Hosts oficiais permitidos para a URL de depósito, separados por vírgula (ex.: app.bullex.com)
BROKER_OFFICIAL_ALLOWED_HOSTS=

# Vídeos
# Validade das URLs assinadas dos vídeos privados (segundos)
VIDEO_SIGNED_URL_TTL_SECONDS=14400
# Hosts https permitidos para vídeos externos (provider external_url), separados por vírgula
VIDEO_EXTERNAL_ALLOWED_HOSTS=
